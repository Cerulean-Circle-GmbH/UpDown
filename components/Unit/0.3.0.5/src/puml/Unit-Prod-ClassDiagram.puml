title @web4x/unit prod (0.3.0.5) — The ORIGINAL Unit Component\nGitTextIOR · MDAv4 · Unified References · Folder Support\n<color:red>Red annotations = missing from Unit 0.3.23.x extraction</color>

' ═══════════════════════════════════════════════════════════════
' LAYER 3: Interfaces & Types
' ═══════════════════════════════════════════════════════════════

package "Layer 3 — Interfaces" as L3 #F5F5F5 {

  interface "Model" as IModel {
    + uuid: string
    + name: string
  }

  interface "Unit" as IUnit {
    + init(scenario?): this
    + toScenario(): Promise<Scenario>
    + from(filename, startPos?, endPos?): Promise<this>
    + link(identifier, filename): Promise<this>
    + linkInto(unit, folder, original?): Promise<this>
    + on(identifier): Promise<this>
    + set(identifier?, attribute, value): Promise<this>
    + get(identifier?, attribute): Promise<this>
    + discover(identifier): Promise<this>
    + find(name): Promise<this>
    + references(identifier): Promise<this>
    + copyInto(identifier, targetFolder): Promise<this>
  }

  interface "Upgrade" as IUpgrade {
    + upgrade(targetVersion): Promise<this>
  }

  interface "UnitModel" as IUnitModel <<extends Model>> {
    + uuid: string
    + name: string
    + origin: string  <<GitTextIOR format>>
    + definition: string  <<GitTextIOR format>>
    + typeM3?: TypeM3
    + indexPath: string
    + <color:red>references: UnitReference[]  <<UNIFIED>></color>
    + createdAt: string
    + updatedAt: string
  }

  interface "UnitReference" as IUnitRef {
    + linkLocation: string  <<ior:local:ln:file://...>>
    + linkTarget: string  <<ior:unit:uuid:...>>
    + syncStatus: SyncStatus
  }

  enum "SyncStatus" as ESS {
    SYNCED
    OUTDATED
    BROKEN
    UNKNOWN
    MODIFIED
    TO_BE_CHECKED
  }

  enum "TypeM3" as ETM3 {
    CLASS
    ATTRIBUTE
    RELATIONSHIP
  }

  interface "BaseIOR" as IBIOR {
    + init(scenario): this
    + toScenario(): Promise<any>
    + validate(): boolean
    + toString(): string
  }

  interface "GitPositioning" as IGP {
    + type: 'line-column' | 'character'
    + startLine?: number
    + startColumn?: number
    + endLine?: number
    + endColumn?: number
    + startChar?: number
    + endChar?: number
  }

  interface "Storage" as ISTG {
    + init(scenario: StorageScenario): this
    + saveScenario(uuid, scenario, paths): Promise<void>
    + loadScenario(uuid): Promise<Scenario>
    + toScenario(): Promise<StorageScenario>
  }

  interface "CLI" as ICLI {
    + execute(args: string[]): Promise<void>
    + showUsage(): void
  }

  class "UUIDv4" as UUID4 <<Value Object>> {
    - value: string
    + constructor(uuidString?: string)
    + {static} generate(): UUIDv4
    + {static} from(str: string): UUIDv4
    + {static} isValid(str: string): boolean
    + toString(): string
    + valueOf(): string
    + isValid(): boolean
    + getVersion(): number
    + equals(other: UUIDv4): boolean
    + toHex(): string
    + toJSON(): string
  }

  IUnitRef --> ESS : syncStatus
  IUnitModel --> ETM3 : typeM3
  IUnitModel --> IUnitRef : references[]
}

