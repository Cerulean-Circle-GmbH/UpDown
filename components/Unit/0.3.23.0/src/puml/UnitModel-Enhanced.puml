package "@web4x/ucp — Layer 3" as UCP_L3 #EEEEEE {
  interface "Model" as IModel {
    + uuid: string
    + name: string
  }

  enum "SyncStatus" as SS {
    SYNCED
    OUTDATED
    BROKEN
    UNKNOWN
    MODIFIED
    TO_BE_CHECKED
    RUNTIME
  }

  enum "TypeM3" as TM3 {
    CLASS
    ATTRIBUTE
    RELATIONSHIP
    **FOLDER**  <<NEW>>
  }

  interface "UnitReference" as IUR {
    + linkLocation: string
    + linkTarget: string
    + syncStatus: SyncStatus
  }

  interface "UnitModel" as IUM <<ALREADY EXISTS>> {
    .. Core Identity ..
    + name: string
    + **origin: string**  <<IOR to source .ts>>
    + definition: string
    + **typeM3?: TypeM3**  <<CLASS/RELATIONSHIP/FOLDER>>
    + indexPath: string
    .. Reference Tracking ..
    + **references: UnitReference[]**  <<bidirectional>>
    .. Timestamps ..
    + createdAt: string
    + updatedAt: string
    .. ONCE Extensions (optional) ..
    + componentType?: string
    + componentIor?: string
    + artefactUuid?: Reference<string>
    + fileUuid?: Reference<string>
  }

  IUM --|> IModel : extends
  IUM --> TM3 : typeM3
  IUM --> IUR : references[]
  IUR --> SS : syncStatus
}

