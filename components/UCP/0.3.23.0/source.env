#!/bin/bash
# @web4x/ucp 0.3.23.0 - Environment setup
# Auto-managed by web4tscomponent initProject
# Foundation component — no external Web4 deps

# Detect project root
if [[ "$PWD" == *"/test/data"* ]]; then
    WEB4_PROJECT_ROOT="$PWD"
else
    WEB4_PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
fi
export WEB4_PROJECT_ROOT

# Component path
SCRIPT_FILE="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_FILE" ]; do
    SCRIPT_FILE="$(readlink "$SCRIPT_FILE")"
done
UCP_DIR="$(cd "$(dirname "$SCRIPT_FILE")" && pwd -P)"
export UCP_DIR
