' LAYER 3: Interfaces & Runtime Types
' ═══════════════════════════════════════════════════════════════

package "Layer 3 — Interfaces" as L3 #F5F5F5 {

  interface "Model" as IModel {
    + uuid: string
    + name: string
  }

  interface "Scenario<TModel>" as IScenario {
    + ior: { uuid, component, version }
    + owner: string
    + model: TModel
  }

  interface "Component<TModel>" as IComponent {
    + model: TModel
    + init(scenario?: Scenario<TModel>): this
    + toScenario(name?: string): Promise<Scenario>
    + hasMethod(name: string): boolean
    + getMethodSignature(name: string): MethodSignature
    + listMethods(): string[]
  }

  interface "Controller<TModel>" as IController {
    + init(model: TModel): this
    + get model(): TModel
    + scenarioReceive(scenario: any): void
    + viewRegister(view: View<TModel>): void
    + viewUnregister(view: View<TModel>): void
  }

  interface "View<TModel>" as IView {
    + render(model: TModel): void
    + update(model: TModel): void
  }

  interface "RelatedObjects" as IRelObj {
    + relatedObjectRegister<T>(key, instance): void
    + relatedObjectLookup<T>(key): T[]
    + relatedObjectLookupFirst<T>(key): Reference<T>
    + relatedObjectUnregister<T>(instance): void
  }

  interface "IDProvider" as IIDProv {
    + create(): string
    + validate(id: string): boolean
  }

  interface "ContentIDProvider" as ICIDProv {
    + contentIdCreate(content): Promise<string>
    + contentIdCreateSync(content): string
  }

  interface "Loader" as ILoader {
    + load(ior: string, options?): Promise<any>
    + save(data, ior: string, options?): Promise<void>
    + exists(path: string): Promise<boolean>
  }

  interface "IOR<T>" as IIOR {
    + initRemote(iorString: string): this
    + initLocal(value: T): this
    + resolve(options?): Promise<T>
    + save(data, options?): Promise<void>
  }

  abstract class "JsInterface" as JSI <<P35: Runtime Interface>> {
    - {static} typeField: TypeDescriptor
    + {static} get type(): TypeDescriptor
    + {static} implementationRegister(cls): void
    + {static} get implementations(): InterfaceConstructor[]
    + {static} implementationCheck(cls): boolean
  }

  abstract class "PersistenceManager" as PM <<extends JsInterface>> {
    + {abstract} scenarioSave(uuid, scenario, paths): Promise<void>
    + {abstract} scenarioLoad(uuid): Promise<Scenario>
    + {abstract} scenarioFind(query): Promise<Scenario[]>
    + {abstract} scenarioDelete(uuid): Promise<void>
    + {abstract} scenarioExists(uuid): Promise<boolean>
    + {abstract} typePathBuild(component, version): string
    + {abstract} domainPathBuild(parts, host, comp, ver): string
    + {abstract} capabilityPathBuild(...): string
  }

  abstract class "Storage" as STG <<extends PersistenceManager>> {
    + {abstract} init(scenario: StorageScenario): this
    + {abstract} toScenario(): Promise<StorageScenario>
  }

  class "UcpModel<T>" as UcpM <<P34: ISR Proxy>> {
    - rawModel: T
    - proxyModel: T
    - updateObjectInternal: Partial<T>
    - viewUpdateCallback: () => void
    - persistenceCallback: Reference<() => void>
    __P6: Lifecycle__
    + constructor()
    + init(model: T, onViewUpdate: () => void): this
    __Model Access__
    + get model(): T  <<ISR Proxy>>
    + get value(): T  <<tracked, no update>>
    + get updateObject(): Partial<T>
    + get isDirty(): boolean
    __Change Management__
    + commit(): void
    + rollback(): void
    + merge(partial: Partial<T>): void
    + mergeSilent(partial: Partial<T>): void
    + persistenceCallbackSet(cb): void
    __ISR Internals (Private)__
    - modelProxyCreate(model: T): T
    - arrayProxyCreate(arr, parent, key): unknown[]
    - valueProxyCreate(model: T): T
  }

  class "TypeDescriptor" as TD <<P28: Object IS Type>> {
    + name: string
    + extends: Reference<TypeDescriptor>
    + implements: Set<InterfaceConstructor>
    + attributes: Map<string, AttributeDescriptor>
    + methods: Map<string, MethodDescriptor>
    + implementingClasses: Set<InterfaceConstructor>
    __P6: Lifecycle__
    + constructor()
    + init(config): this
    + {static} fromASTData(astData): TypeDescriptor
    __P16: Lookup Methods__
    + attributeLookup(name): Reference<AttributeDescriptor>
    + methodLookup(name): Reference<MethodDescriptor>
    + get implementations(): InterfaceConstructor[]
    + implementationAdd(cls): void
    + implementsAdd(iface): void
    + toJSON(): TypeDescriptorJSON
  }

  PM --|> JSI : extends
  STG --|> PM : extends
  ICIDProv --|> IIDProv : extends
}

