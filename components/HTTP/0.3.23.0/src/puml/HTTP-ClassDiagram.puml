@startuml HTTP-ClassDiagram
!theme plain
skinparam backgroundColor White
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 9
skinparam classAttributeIconSize 0

title @web4x/http 0.3.23.0 — HTTP Server Stack\nDepends on: @web4x/ucp

package "Layer 3 — Interfaces & Runtime Types" as L3 #F5F5F5 {
  interface "HTTPServerModel" as IHSM {
    + port: number
    + host: string
    + state: LifecycleState
    + statistics: StatisticsModel
  }

  interface "RouterModel" as IRM {
    + routes: RouteModel[]
    + statistics: StatisticsModel
  }

  interface "RouteModel" as IRoM {
    + pattern: string
    + methods: HttpMethod[]
    + statistics: StatisticsModel
  }

  enum "HttpMethod" as HM {
    GET
    POST
    PUT
    DELETE
    PATCH
    OPTIONS
    HEAD
  }
}

package "Layer 2 — Implementation" as L2 #E8F5E9 {

  class "HTTPServer" as HS <<P6 + P7: sync layer2>> {
    + model: HTTPServerModel
    - server: Reference<Server>
    - router: HTTPRouter
    __P6: Lifecycle__
    + constructor()
    + init(scenario?): this
    + toScenario(): Scenario
    __Server Operations__
    + start(): Promise<this>
    + stop(): Promise<this>
    + routerSet(router: HTTPRouter): void
    + get isRunning(): boolean
    + get port(): number
  }

  class "HTTPRouter" as HR <<P2: Convention over Config>> {
    + model: RouterModel
    - routes: Map<string, Route>
    - errorRoute: ErrorRoute
    __P6: Lifecycle__
    + constructor()
    + init(scenario?): this
    __Routing__
    + routeRegister(route: Route): void
    + routeUnregister(pattern, method): void
    + routeMatch(req): Reference<Route>
    + handle(req, res): Promise<void>
    + errorHandle(req, res, error): Promise<void>
    + get routeList(): Route[]
  }

  abstract class "Route" as R <<P6: Abstract Base>> {
    + model: RouteModel
    + constructor()
    + {abstract} init(scenario?): this
    + {abstract} handle(req, res): Promise<void>
    + matches(path, method): boolean
    + get pattern(): string
    + get methods(): HttpMethod[]
  }

  class "ErrorRoute" as ER <<P4b: Polymorphic Error>> {
    + handle(req, res): Promise<void>
  }

  class "HTMLRoute" as HtR <<Static HTML Pages>> {
    + handle(req, res): Promise<void>
  }

  class "IORRoute" as IR <<P12: IOR Method Invocation>> {
    + handle(req, res): Promise<void>
  }

  class "ScenarioRoute" as ScR <<P1: Everything is Scenario>> {
    + handle(req, res): Promise<void>
  }

  class "ManifestRoute" as MR {
    + handle(req, res): Promise<void>
  }

  class "ServiceWorkerRoute" as SWR <<PWA>> {
    + handle(req, res): Promise<void>
  }

  class "UnitsRoute" as UR {
    + handle(req, res): Promise<void>
  }

  class "PortManager" as PM <<Singleton>> {
    - {static} instance: PortManager
    + PRIMARY_PORT: 42777
    + FALLBACK_PORT_START: 8080
    + {static} getInstance(): PortManager
    + isPortAvailable(port): Promise<boolean>
    + getNextAvailablePort(): Promise<PortAvailabilityResult>
    + isPrimaryServerRunning(): Promise<boolean>
    + getPrimaryPort(): number
    + isPrimaryPort(port): boolean
  }

  ER --|> R
  HtR --|> R
  IR --|> R
  ScR --|> R
  MR --|> R
  SWR --|> R
  UR --|> R

  HS --> HR : router
  HR --> R : routes[]
  HR --> ER : errorRoute
  HS ..> PM : port discovery
}

package "Layer 4 — Async Orchestration (P7: only async layer)" as L4 #FFF3E0 {
  class "IORMethodRouter" as IORMR <<P12: IOR URL → Method>> {
    + model: {uuid, name}
    + parseRequest(req): IORMethodCall
    + routeToMethod(call): Promise<any>
  }

  IR --> IORMR : delegates\nIOR URL parsing
}

note right of R
  **7 Route Subclasses (P4b)**
  Each route type handles its own
  response format polymorphically.
  No switch/case in Router —
  just route.handle(req, res).
end note

note bottom of PM
  **Port Hierarchy**
  42777 = ONCE primary
  8080+ = fallback scan
  Primary server gets discovery
  port for P2P peer finding.
end note

@enduml
