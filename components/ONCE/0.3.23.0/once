#!/bin/bash
# @web4x/once CLI Tool - Location Independent Version
# Web4 pattern: Derives project root from own location, never from $PWD
# Self-registering: creates version symlink on first run

# Resolve real script path (follow symlinks)
SCRIPT_FILE="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_FILE" ]; do
    SCRIPT_FILE="$(readlink "$SCRIPT_FILE")"
    if [[ "$SCRIPT_FILE" != /* ]]; then
        SCRIPT_FILE="$(dirname "${BASH_SOURCE[0]}")/$SCRIPT_FILE"
    fi
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_FILE")" && pwd -P)"

# Component identity from directory name (single source of truth)
COMPONENT_VERSION="$(basename "$SCRIPT_DIR")"
COMPONENT_NAME="$(basename "$(dirname "$SCRIPT_DIR")")"
COMPONENT_PATH="$SCRIPT_DIR"
CLI_NAME="$(echo "$COMPONENT_NAME" | tr '[:upper:]' '[:lower:]')"

# Project root: derive from component path (components/{Name}/{Version} → 3 levels up)
# This is the authoritative source — never depends on $PWD
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd -P)"
export PROJECT_ROOT

# Self-registration: create version symlink if missing
VERSIONS_DIR="$PROJECT_ROOT/scripts/versions"
VERSION_LINK="$VERSIONS_DIR/${CLI_NAME}-v${COMPONENT_VERSION}"
if [ -d "$VERSIONS_DIR" ] && [ ! -e "$VERSION_LINK" ]; then
    RELATIVE_TARGET="../../components/${COMPONENT_NAME}/${COMPONENT_VERSION}/${CLI_NAME}"
    ln -s "$RELATIVE_TARGET" "$VERSION_LINK" 2>/dev/null && \
        echo "[self-register] Created ${CLI_NAME}-v${COMPONENT_VERSION}"
fi

# Source component environment if available
SOURCE_ENV_PATH="$COMPONENT_PATH/source.env"
if [ -f "$SOURCE_ENV_PATH" ]; then
    if ! declare -F _web4_generic_completion > /dev/null 2>&1; then
        source "$SOURCE_ENV_PATH"
    fi
fi

# Change to component directory and build
cd "$COMPONENT_PATH" || exit 1
./src/sh/build.sh

# Check if CLI is available
CLI_PATH="dist/ts/layer5/ONCECLI.js"
if [ ! -f "$CLI_PATH" ]; then
    echo "ERROR: ONCE CLI build failed"
    exit 1
fi

# Execute CLI — cd to project root so context is correct
cd "$PROJECT_ROOT" || exit 1
node "$COMPONENT_PATH/$CLI_PATH" "$@"
