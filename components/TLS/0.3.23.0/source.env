#!/bin/bash
# @web4x/tls — Environment setup
# Library component

# Detect project root
if [[ "$PWD" == *"/test/data"* ]]; then
    WEB4_PROJECT_ROOT="$PWD"
else
    WEB4_PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
fi
export WEB4_PROJECT_ROOT

# Component path
SCRIPT_FILE="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_FILE" ]; do
    SCRIPT_FILE="$(readlink "$SCRIPT_FILE")"
done
TLS_DIR="$(cd "$(dirname "$SCRIPT_FILE")" && pwd -P)"
export TLS_DIR

# Add scripts to PATH
export PATH="$WEB4_PROJECT_ROOT/scripts:$WEB4_PROJECT_ROOT/scripts/versions:$PATH"
