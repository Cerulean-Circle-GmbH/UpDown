@startuml QnD-Multiplayer-UseCases
!theme plain
skinparam backgroundColor White
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 9

title UpDown QnD Multiplayer — Use Cases (Sprint 3 Complete)

left to right direction

actor "Player" as player
actor "Host" as host
actor "Spectator" as spectator
actor "Bot (AI)" as bot

' ═══════════════════════════════════════════════════════════════
' LOBBY
' ═══════════════════════════════════════════════════════════════

rectangle "Lobby System" as Lobby {
  ' @uc:uuid:92a061e0 connection.open
  usecase "UC1: lobby.connect\n(WebSocket + name)" as UC1
  ' @uc:uuid:fbfed148 room.create
  usecase "UC2: lobby.createRoom\n(name, maxPlayers, key?)" as UC2
  ' @uc:uuid:9cc60247 room.join
  usecase "UC3: lobby.joinRoom\n(roomId, key?)" as UC3
  ' @uc:uuid:7cd55a0b rooms.list
  usecase "UC4: lobby.listRooms\n(public only)" as UC4
  ' @uc:uuid:96f2ecd5 room.leave
  usecase "UC5: lobby.leaveRoom" as UC5
  ' @uc:uuid:433fe03f room.share
  usecase "UC6: lobby.shareInvite\n(clipboard/share API)" as UC6

  usecase "UC1a: WebSocketClient.connect()" as UC1a
  usecase "UC1b: server.handleConnection()" as UC1b
  usecase "UC2a: RoomManager.createRoom()" as UC2a
  usecase "UC3a: GameRoom.addPlayer()" as UC3a
  usecase "UC6a: ShareUtil.shareRoomLink()" as UC6a
}

player --> UC1
player --> UC3
player --> UC4
player --> UC5
player --> UC6
host --> UC2

UC1 ..> UC1a : <<include>>
UC1 ..> UC1b : <<include>>
UC2 ..> UC2a : <<include>>
UC3 ..> UC3a : <<include>>
UC6 ..> UC6a : <<include>>

' ═══════════════════════════════════════════════════════════════
' GAME FLOW
' ═══════════════════════════════════════════════════════════════

rectangle "Multiplayer Game" as Game {
  ' @uc:uuid:560d9a46 game.start
  usecase "UC7: game.start\n(host only)" as UC7
  ' @uc:uuid:f0295f28 player.guess
  usecase "UC8: game.playCard\n(up/down/equal)" as UC8
  ' @uc:uuid:f43897d5 player.playSpecial
  usecase "UC9: game.playSpecial\n(13 card types, 3 levels)" as UC9
  ' @uc:uuid:e5c73817 round.resolve
  usecase "UC10: game.receiveResult\n(scores, eliminations)" as UC10
  ' @uc:uuid:38d62fef game.end
  usecase "UC11: game.over\n(leaderboard + diamonds)" as UC11
  ' @uc:uuid:f8e39106 round.start
  usecase "UC12: game.nextRound\n(auto after 3s exchange)" as UC12

  usecase "UC7a: GameRoom.startGame()" as UC7a
  usecase "UC7b: GameRoom.nextRound()" as UC7b
  usecase "UC8a: GameRoom.playCard()" as UC8a
  usecase "UC8b: GameRoom.startCountdown()" as UC8b
  usecase "UC9a: SpecialCards.applyEffect()" as UC9a
  usecase "UC10a: GameRoom.resolveRound()" as UC10a
  usecase "UC11a: GameRoom.endGame()" as UC11a
}

host --> UC7
player --> UC8
player --> UC9
player --> UC10
player --> UC11

UC7 ..> UC7a : <<include>>
UC7 ..> UC7b : <<include>>
UC8 ..> UC8a : <<include>>
UC8 ..> UC8b : <<include>>
UC9 ..> UC9a : <<include>>
UC10 ..> UC10a : <<include>>
UC11 ..> UC11a : <<include>>
UC12 ..> UC7b : <<include>>

' ═══════════════════════════════════════════════════════════════
' BOT SYSTEM
' ═══════════════════════════════════════════════════════════════

rectangle "AI Bot System" as BotSys {
  ' @uc:uuid:f1ba3e42 bot.add
  usecase "UC13: bot.add\n(host picks personality)" as UC13
  ' @uc:uuid:8e46d39e bot.decide
  usecase "UC14: bot.decide\n(card-counting heuristic)" as UC14
  ' @uc:uuid:2d695025 bot.playDelayed
  usecase "UC15: bot.playDelayed\n(1-8s human feel)" as UC15

  usecase "UC13a: GameRoom.addBot()" as UC13a
  usecase "UC14a: BotPlayer.decideGuess()" as UC14a
  usecase "UC15a: BotPlayer.observeCard()" as UC15a
}

host --> UC13
bot --> UC14
bot --> UC15

UC13 ..> UC13a : <<include>>
UC14 ..> UC14a : <<include>>
UC14 ..> UC15a : <<include>>

' ═══════════════════════════════════════════════════════════════
' SPECTATOR
' ═══════════════════════════════════════════════════════════════

rectangle "Spectator Mode" as Spec {
  ' @uc:uuid:ac08aa49 spectator.join
  usecase "UC16: spectate.join\n(watch live game)" as UC16
  ' @uc:uuid:d30575e7 spectator.leave
  usecase "UC17: spectate.leave" as UC17
  ' @uc:uuid:df7ec971 spectator.joinNext
  usecase "UC18: spectate.joinNext\n(become player next game)" as UC18

  usecase "UC16a: GameRoom.addSpectator()" as UC16a
}

spectator --> UC16
spectator --> UC17
spectator --> UC18

UC16 ..> UC16a : <<include>>

' ═══════════════════════════════════════════════════════════════
' SOCIAL
' ═══════════════════════════════════════════════════════════════

rectangle "Social Features" as Social {
  ' @uc:uuid:0dfe22b0 chat.send
  usecase "UC19: chat.send\n(room chat)" as UC19
  ' @uc:uuid:433fe03f profile.view (client-only)
  usecase "UC20: profile.view\n(player stats, avatar)" as UC20
  ' @uc:uuid:ea33c5b7 game.end.playAgain
  usecase "UC21: share.result\n(game over stats)" as UC21

  usecase "UC19a: GameRoom.broadcastChat()" as UC19a
}

player --> UC19
player --> UC20
player --> UC21

UC19 ..> UC19a : <<include>>
UC21 ..> UC6a : <<include>>

' ═══════════════════════════════════════════════════════════════
' SINGLE PLAYER (existing)
' ═══════════════════════════════════════════════════════════════

rectangle "Single Player (Rapid Mode)" as SP {
  usecase "UC22: rapid.start\n(52-card solo)" as UC22
  usecase "UC23: rapid.guess\n(up/down/equal)" as UC23
  usecase "UC24: rapid.gameOver\n(score + restart)" as UC24

  usecase "UC22a: GameModel.startNewGame()" as UC22a
  usecase "UC23a: GameModel.makeGuess()" as UC23a
}

player --> UC22
player --> UC23
player --> UC24

UC22 ..> UC22a : <<include>>
UC23 ..> UC23a : <<include>>

' ═══════════════════════════════════════════════════════════════
' INFRASTRUCTURE
' ═══════════════════════════════════════════════════════════════

rectangle "Server Infrastructure" as Infra {
  usecase "UC25: server.tui\n(status, clients, logs)" as UC25
  usecase "UC26: pwa.install\n(offline + home screen)" as UC26
}

actor "Admin" as admin
admin --> UC25
player --> UC26

' ═══════════════════════════════════════════════════════════════
' Cross-cutting: Timeout auto-resolves
' ═══════════════════════════════════════════════════════════════

note right of UC8b
  10-second countdown.
  If all alive players play early,
  countdown cancels → immediate resolve.
  If timeout: no-guess = eliminated.
end note

note right of UC14a
  Card counting heuristic:
  P(up) = cardsAbove / remaining
  P(down) = cardsBelow / remaining
  P(equal) = cardsEqual / remaining
  Pick argmax with personality modifier.
end note

note bottom of UC9
  13 special cards across 3 levels:
  L1: Shield, Mass Intel, Double Points
  L2: Peek, Sacrifice, Swap, Reveal
  L3: Freeze, Team Save, 2nd Chance, Steal
  Priority: L3 > L2 > L1
end note

@enduml
